    "ex5": {
      "expected_zip_regex": "^ex5\\.zip$",
      "expected_files": [
        "cipher_cracker.py"
      ],
      "expected_non_code_files": [
        "test_cipher_cracker.py",
        "runtime_report.png",
        "README.txt"
      ],
      "strict_zip_contents": true,
      "pytest_files": [
        "test_cipher_cracker.py"
      ],
      "ast_rules": {
        "cipher_cracker.py": {
          "allowed_imports": ["sys", "typing"],
          "required_calls": [
            "load_word_scores",
            "load_keys",
            "decrypt_vigenere",
            "score_text",
            "crack_cipher",
            "write_report"
          ]
        }
      },
      "specific_tests": [
        {
          "description": "load_word_scores - standard file parsing",
          "file": "cipher_cracker.py",
          "func_name": "load_word_scores",
          "setup_files": {
            "words_std.txt": "the,1\nattack,10\ndawn,6\nat,1\n"
          },
          "inputs": ["words_std.txt"],
          "expected": {"the": 1, "attack": 10, "dawn": 6, "at": 1},
          "output_method": "return"
        },
        {
          "description": "load_word_scores - empty file returns empty dict",
          "file": "cipher_cracker.py",
          "func_name": "load_word_scores",
          "setup_files": {
            "words_empty.txt": ""
          },
          "inputs": ["words_empty.txt"],
          "expected": {},
          "output_method": "return"
        },
        {
          "description": "load_keys - standard file and skips blank lines",
          "file": "cipher_cracker.py",
          "func_name": "load_keys",
          "setup_files": {
            "keys_std.txt": "apple\n\norange\nlemon\nbanana\n"
          },
          "inputs": ["keys_std.txt"],
          "expected": ["apple", "orange", "lemon", "banana"],
          "output_method": "return"
        },
        {
          "description": "load_keys - empty or whitespace-only file returns empty list",
          "file": "cipher_cracker.py",
          "func_name": "load_keys",
          "setup_files": {
            "keys_empty.txt": "\n\n\n"
          },
          "inputs": ["keys_empty.txt"],
          "expected": [],
          "output_method": "return"
        },
        {
          "description": "decrypt_vigenere - single word",
          "file": "cipher_cracker.py",
          "func_name": "decrypt_vigenere",
          "inputs": ["lxfopv", "lemon"],
          "expected": "attack",
          "output_method": "return"
        },
        {
          "description": "decrypt_vigenere - multi-word restarts key and preserves spaces",
          "file": "cipher_cracker.py",
          "func_name": "decrypt_vigenere",
          "inputs": ["lxfopv lx oeib", "lemon"],
          "expected": "attack at dawn",
          "output_method": "return"
        },
        {
          "description": "decrypt_vigenere - identity key 'a'",
          "file": "cipher_cracker.py",
          "func_name": "decrypt_vigenere",
          "inputs": ["hello world", "a"],
          "expected": "hello world",
          "output_method": "return"
        },
        {
          "description": "score_text - standard scoring",
          "file": "cipher_cracker.py",
          "func_name": "score_text",
          "inputs": [
            "attack at dawn",
            {"attack": 10, "at": 1, "dawn": 6}
          ],
          "expected": 17,
          "output_method": "return"
        },
        {
          "description": "score_text - repeated words counted multiple times",
          "file": "cipher_cracker.py",
          "func_name": "score_text",
          "inputs": [
            "attack attack at dawn",
            {"attack": 10, "at": 1, "dawn": 6}
          ],
          "expected": 27,
          "output_method": "return"
        },
        {
          "description": "score_text - no matching words returns 0",
          "file": "cipher_cracker.py",
          "func_name": "score_text",
          "inputs": [
            "unknown words only",
            {"attack": 10, "dawn": 6}
          ],
          "expected": 0,
          "output_method": "return"
        },
        {
          "description": "crack_cipher - finds highest scoring candidate",
          "file": "cipher_cracker.py",
          "func_name": "crack_cipher",
          "inputs": [
            "lxfopv lx oeib",
            ["apple", "orange", "lemon", "banana"],
            {"attack": 10, "at": 1, "dawn": 6}
          ],
          "expected": ["lemon", 17, "attack at dawn"],
          "expected_type": "tuple",
          "output_method": "return"
        },
        {
          "description": "crack_cipher - tie-breaking picks first key in list",
          "file": "cipher_cracker.py",
          "func_name": "crack_cipher",
          "inputs": [
            "lxfopv",
            ["firstkey", "secondkey"],
            {}
          ],
          "expected": ["firstkey", 0, "gpowwl"],
          "expected_type": "tuple",
          "output_method": "return"
        },
        {
          "description": "write_report - writes exact key/score/text format",
          "file": "cipher_cracker.py",
          "func_name": "write_report",
          "inputs": [
            ["lemon", 17, "attack at dawn"],
            "test_report.txt"
          ],
          "expected_file_content": {
            "filename": "test_report.txt",
            "content": "key:lemon\nscore:17\ntext:attack at dawn\n",
            "exact_match": true
          },
          "output_method": "return"
        },
        {
          "description": "CLI - wrong number of arguments exits with code 1 and Usage message",
          "file": "cipher_cracker.py",
          "run_as_main": true,
          "mock_argv": ["cipher_cracker.py", "enc.txt", "keys.txt"],
          "expected_exit_code": 1,
          "expected": "Usage: cipher_cracker.py encrypted_file keys_file words_file output_file num_keys",
          "output_method": "stdout"
        },
        {
          "description": "CLI - missing input file exits with code 1 and exact Error message",
